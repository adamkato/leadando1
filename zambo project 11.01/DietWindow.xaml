<Window x:Class="zambo_project_11__01.DietWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Étrend Ajánló" Height="400" Width="600"
        Background="#1E1E2F" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🥗 Étrend és Kalória Ajánló" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,15">
            <TextBlock Text="Cél kategória:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="CategoryCombo" Width="150" Height="30" SelectedIndex="0" SelectionChanged="CategoryCombo_SelectionChanged">
                <ComboBoxItem Content="Tömegelés"/>
                <ComboBoxItem Content="Szálkásítás"/>
            </ComboBox>
        </StackPanel>

        <DataGrid x:Name="DietGrid" Grid.Row="2" AutoGenerateColumns="False" Background="#2A2A40" Foreground="White" RowBackground="#1E1E2F" AlternatingRowBackground="#252538">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Étel Neve" Binding="{Binding MealName}" Width="220"/>
                <DataGridTextColumn Header="Kalória (kcal)" Binding="{Binding Calories}" Width="120"/>
                <DataGridTextColumn Header="Fehérje (g)" Binding="{Binding Protein}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>