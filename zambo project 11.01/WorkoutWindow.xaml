<Window x:Class="zambo_project_11__01.WorkoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edzésterv Kezelő és Generátor" Height="450" Width="700"
        Background="#1E1E2F" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🏋️ Edzéskezelő és Cél Alapú Terv Generátor" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

        <DataGrid x:Name="WorkoutsGrid" Grid.Row="1" AutoGenerateColumns="False" Margin="0,15,0,15" Background="#2A2A40" Foreground="White" RowBackground="#1E1E2F" AlternatingRowBackground="#252538">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Edzés Neve" Binding="{Binding Title}" Width="200"/>
                <DataGridTextColumn Header="Célzott Izom" Binding="{Binding TargetMuscle}" Width="150"/>
                <DataGridTextColumn Header="Időtartam (perc)" Binding="{Binding DurationMinutes}" Width="120"/>
                <DataGridTextColumn Header="Cél" Binding="{Binding GoalType}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <ComboBox x:Name="GoalComboBox" Width="150" Height="30" Margin="5" SelectedIndex="0">
                <ComboBoxItem Content="Tömegelés"/>
                <ComboBoxItem Content="Szálkásítás"/>
            </ComboBox>
            <Button Content="✨ Új Terv Generálása (API)" Click="GenerateButton_Click" Width="180" Height="35" Background="#10B981" Foreground="White" FontWeight="Bold" Margin="5"/>
            <Button Content="🔄 Listázás" Click="LoadWorkouts" Width="100" Height="35" Background="#4F46E5" Foreground="White" FontWeight="Bold" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>