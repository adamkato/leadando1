<Window x:Class="zambo_project_11__01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FitPulse Pro - Vezérlőpult" Height="500" Width="800"
        Background="#1E1E2F" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="⚡ FitPulse Regenerációs és Edzés Dashboard" FontSize="22" FontWeight="Bold" Foreground="White"/>
        </StackPanel>

        <!-- Testrészek / Regenerációs állapot kártyák -->
        <GroupBox Grid.Row="1" Header=" Testrészek Regenerációs Státusza (Zöld: Edzhető | Sárga: Pihenj | Piros: Kritikus) " Foreground="White" FontSize="14" Margin="0,15,0,15">
            <ListBox x:Name="BodyPartsListBox" Background="Transparent" BorderBrush="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2A2A40" CornerRadius="10" Padding="15" Margin="5" Width="220">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding RecoveryStatus, StringFormat='Regeneráció: {0}%'}" Foreground="#AAAAAA" Margin="0,5,0,5"/>
                                <TextBlock Text="{Binding StatusColor}" FontWeight="Bold" Margin="0,5,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusColor}" Value="Zöld">
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusColor}" Value="Sárga">
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusColor}" Value="Piros">
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Content="Edzés erre (Lemerítés)" Click="TrainButton_Click" Tag="{Binding Id}" Background="#4F46E5" Foreground="White" FontWeight="Bold" Padding="5" BorderBrush="Transparent"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </GroupBox>

        <!-- Navigációs gombok más ablakokhoz -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="🏋️ Edzéstervek és Generátor" Click="OpenWorkoutWindow" Width="200" Height="40" Background="#10B981" Foreground="White" FontWeight="Bold" Margin="10" BorderBrush="Transparent"/>
            <Button Content="🥗 Étrend Ajánló" Click="OpenDietWindow" Width="200" Height="40" Background="#3B82F6" Foreground="White" FontWeight="Bold" Margin="10" BorderBrush="Transparent"/>
            <Button Content="🔄 Frissítés" Click="RefreshData" Width="100" Height="40" Background="#6B7280" Foreground="White" FontWeight="Bold" Margin="10" BorderBrush="Transparent"/>
        </StackPanel>
    </Grid>
</Window>